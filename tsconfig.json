{
  "compilerOptions": {
    "target": "es6",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,          
    "checkJs": false,         
    "skipLibCheck": true,     
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "strict": false,          
    "forceConsistentCasingInFileNames": true,
    "module": "node16",
    "moduleResolution": "node16",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,           
    "jsx": "react-jsx"        
  },
  "include": ["src"]          
}
